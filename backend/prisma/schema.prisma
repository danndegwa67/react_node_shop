datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated-client"
}

model Category {
  id       String    @id
  name     String
  products Product[]
}

model Vehicle {
  id       String    @id
  make     String
  model    String
  products Product[]
}

model Product {
  sku          String                 @id
  productName  String
  position     String?  
  sellingPrice Float
  stock        Int                    @default(0)
  heldStock    Int                    @default(0)    // 🔒 Module 1: Reserved Stock Hold
  reorderPoint Int                    @default(3)    // 🚨 Module 2: Low-Stock Threshold Trigger
  condition    String                 @default("OEM_GENUINE") // 🧩 Module 4: OEM_GENUINE, AFTERMARKET, USED, REFURBISHED
  side         String                 @default("UNIVERSAL")   // 🧩 Module 4: UNIVERSAL, LEFT_LH, RIGHT_RH, FRONT, REAR, PAIR
  category_id  String
  category     Category               @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vehicle_id   String
  vehicle      Vehicle                @relation(fields: [vehicle_id], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]            // Relates to order processing
  transactions InventoryTransaction[] // 📜 Module 3: Stock Movement Ledger History
  createdAt    DateTime               @default(now())
}

// 📜 Module 3: Immutable Inventory Ledger Table
model InventoryTransaction {
  id             String   @id @default(uuid())
  productSku     String
  product        Product  @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  type           String   // INBOUND_CARGO, ORDER_DISPATCH, ADJUSTMENT_CORRECTION, ORDER_HOLD, RELEASE_HOLD
  quantityChange Int
  previousStock  Int
  newStock       Int
  referenceId    String?  // Associated Order or Adjustment ID
  actorName      String
  createdAt      DateTime @default(now())
}

// 👥 Employee access controls
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  name      String
  role      String   @default("employee") 
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

// 📦 Customer/Invoice Orders requiring approval
model Order {
  id           String      @id @default(uuid())
  customerName String
  status       String      @default("PENDING") // PENDING, APPROVED, DISAPPROVED, DISPATCHED
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

// 📋 Join Table: Products inside an order
model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSku String
  product    Product @relation(fields: [productSku], references: [sku])
  quantity   Int
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String? 
  userName  String   @default("System / Scanner")
  action    String   
  details   String   
  createdAt DateTime @default(now())
}

model StockAdjustment {
  id           String   @id @default(uuid())
  productSku   String
  productName  String
  oldStock     Int
  newStock     Int
  reason       String
  requestedBy  String   
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now())
}