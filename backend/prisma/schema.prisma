datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated-client"
}

model Category {
  id       String    @id
  name     String
  products Product[]
}

model Vehicle {
  id       String    @id
  make     String
  model    String
  products Product[]
}

model Product {
  sku          String      @id
  productName  String
  position     String?  
  sellingPrice Float
  stock        Int         @default(0)
  category_id  String
  category     Category    @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vehicle_id   String
  vehicle      Vehicle     @relation(fields: [vehicle_id], references: [id], onDelete: Restrict)
  orderItems   OrderItem[] // Relates to order processing
  createdAt    DateTime @default(now())
}

// 👥 New Table: Employee access controls
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  name      String
  role      String   @default("employee") 
  status    String   @default("PENDING")  // 👈 Ensure this exact line is present
  createdAt DateTime @default(now())
}

// 📦 New Table: Customer/Invoice Orders requiring approval
model Order {
  id          String      @id @default(uuid())
  customerName String
  status      String      @default("PENDING") // PENDING, APPROVED, DISAPPROVED, DEPARTED
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

// ⛓️ Join Table: Products inside an order
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSku String
  product   Product @relation(fields: [productSku], references: [sku])
  quantity  Int
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String? 
  userName  String   @default("System / Scanner")
  action    String   // e.g., "APPROVED_ORDER", "SCAN_DEPARTURE", "REGISTER_USER"
  details   String   // e.g., "Approved order ref: MT-2026-4821"
  createdAt DateTime @default(now())
}

model StockAdjustment {
  id           String   @id @default(uuid())
  productSku   String
  productName  String
  oldStock     Int
  newStock     Int
  reason       String
  requestedBy  String   // Name of staff member who initiated it
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now())
}